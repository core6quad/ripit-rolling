{
	"name": "elv-poc",
	"version": "1.0.0",
	"main": "dist/main/main.js",
	"scripts": {
		"dev": "vite",
		"electron-dev": "concurrently \"vite\" \"electron .\"",
		"build": "vite build",
		"tsc": "tsc",
		"el": "electron .",
		"go2": "yarn build && yarn tsc && electron .",
		"go": "(yarn build && yarn tsc && electron .) 2>&1 | grep -v 'eglQueryDeviceAttribEXT'",
		"build:mac": "yarn build && tsc && electron-builder"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "commonjs",
	"devDependencies": {
		"@types/node": "^22.14.1",
		"@vitejs/plugin-vue": "^5.2.3",
		"@vue/cli-service": "^3.3.1",
		"@vue/compiler-sfc": "^3.5.13",
		"electron": "35.1.5",
		"electron-builder": "^26.0.12",
		"typescript": "^5.8.3",
		"vite": "^6.2.6",
		"vue": "^3.5.13",
		"naive-ui": "^2.41.0",
		"vue-router": "^4.5.0",
		"@vicons/ionicons5": "^0.13.0",
		"lodash": "^4.17.21",
		"filesize": "^10.1.6",
		"mitt": "^3.0.1",
		"zod": "3.24.3"
	},
	"build": {
		"appId": "com.yourapp.id",
		"productName": "ElectronVuePoC",
		"directories": {
			"output": "release-builds"
		},
		"files": [
			"dist/**/*",
			"node_modules/**/*",
			"package.json"
		],
		"asar": true,
		"win": {
			"target": "nsis"
		},
		"mac": {
			"target": "dmg",
			"category": "public.app-category.utilities"
		},
		"linux": {
			"target": [
				"AppImage",
				"deb"
			]
		},
		"extraResources": [
			{
				"from": "node_modules/electron-dl",
				"to": "node_modules/electron-dl"
			},
			{
				"from": "node_modules/uuid",
				"to": "node_modules/uuid"
			},
			{
				"from": "node_modules/extract-zip",
				"to": "node_modules/extract-zip"
			},
			{
				"from": "node_modules/lodash-es",
				"to": "node_modules/lodash-es"
			},
			{
				"from": "node_modules/filesize",
				"to": "node_modules/filesize"
			},
			{
				"from": "node_modules/mitt",
				"to": "node_modules/mitt"
			},
			{
				"from": "node_modules/zod",
				"to": "node_modules/zod"
			}
		]
	},
	"dependencies": {
		"electron-dl": "^4.0.0",
		"extract-zip": "^2.0.1",
		"lodash-es": "^4.17.21",
		"filesize": "^10.1.6",
		"mitt": "^3.0.1",
		"zod": "3.24.3"
	},
	"description": ""
}